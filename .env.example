# Copiați în .env și completați. Fără GEMINI_API_KEY totul merge, dar fără AI
# (clustere din „Tichet legat”, explicații generate din pași, planuri scrise de mână).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# gemini (implicit) | vertex — rulați: python -m app.check_gemini
GEMINI_BACKEND=gemini

# embeddings (implicit dacă există cheie) | legat
# CLUSTER_MODE=embeddings
SIMILARITY_THRESHOLD=0.85

# hand = planuri scrise de mână (sigur) | gemini = generate din „Pași de verificare”
PLANNER_MODE=hand

# false = se vede browserul agentului (recomandat în demo)
HEADLESS=true

WIZZ_BEES_URL=http://localhost:5173
DEFAULT_VERSION=3.14.0
DEFAULT_INTERVAL_MIN=2
PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=*
